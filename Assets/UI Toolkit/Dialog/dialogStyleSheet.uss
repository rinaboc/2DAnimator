.dialog {
    align-self: center;
    background-color: rgb(175, 175, 174);
    position: absolute;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(43, 43, 43);
    border-right-color: rgb(43, 43, 43);
    border-top-color: rgb(43, 43, 43);
    border-bottom-color: rgb(43, 43, 43);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    font-size: 32px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
}

.dialog-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.exit-button {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&guid=06973cdbfc0f48c42ad57bbefc516867&type=3#Remove@2x");
    background-size: 80% 80%;
}

.dialog-content {
    flex-grow: 1;
}

.hide {
    display: none;
}

.property-line {
    flex-direction: row;
    justify-content: space-between;
}

IntegerField {
    flex-grow: 0;
    width: 100px;
    background-color: rgb(34, 34, 34);
    font-size: 28px;
}

.property-label {
    flex-grow: 1;
    font-size: 28px;
    -unity-text-align: middle-left;
}
