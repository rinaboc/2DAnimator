<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/PopupWindow/PopupWindowStylesheet.uss?fileID=7433441132597879392&amp;guid=87f952f9aba525e478f03fb13f024c73&amp;type=3#PopupWindowStylesheet" />
    <ui:VisualElement name="Backdrop" style="flex-grow: 1; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(20, 18, 22, 0.26);" />
    <ui:VisualElement name="MainPanel" style="flex-grow: 1; width: 350px; height: 316px; align-items: flex-start; justify-content: center; position: absolute; top: 30%; left: 50%; background-color: rgb(169, 169, 168); align-self: auto; align-content: auto; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(51, 51, 51, 0.5); border-right-color: rgba(51, 51, 51, 0.5); border-top-color: rgba(51, 51, 51, 0.5); border-bottom-color: rgba(51, 51, 51, 0.5); scale: 2 2;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; width: 100%; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <ui:Label text="Parameter Settings" style="flex-grow: 1; -unity-text-align: middle-left; font-size: 18px;" />
            <ui:Button name="ExitButton" style="white-space: pre-wrap; align-self: center; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&amp;guid=06973cdbfc0f48c42ad57bbefc516867&amp;type=3#Remove@2x&quot;); margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 30px; height: 30px; background-size: 80% 80%;" />
        </ui:VisualElement>
        <ui:TextField label="Name" placeholder-text="parameter" name="ParamName" style="width: 312px;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="m_paramName" data-source-type="PopupWindowController, Assembly-CSharp" binding-mode="TwoWay" />
            </Bindings>
        </ui:TextField>
        <ui:FloatField label="Min" value="0" name="MinField">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="m_minValue" data-source-type="PopupWindowController, Assembly-CSharp" binding-mode="TwoWay" />
            </Bindings>
        </ui:FloatField>
        <ui:FloatField label="Max" value="2" name="MaxField">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="m_maxValue" data-source-type="PopupWindowController, Assembly-CSharp" binding-mode="TwoWay" />
            </Bindings>
        </ui:FloatField>
        <ui:FloatField label="Default" value="1" name="DefaultField">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="m_defaultValue" data-source-type="PopupWindowController, Assembly-CSharp" binding-mode="TwoWay" />
            </Bindings>
        </ui:FloatField>
        <ui:Button text="Create" name="CreateButton" style="width: 50%; align-self: center; margin-top: 6px; margin-bottom: 6px;" />
        <ui:Label text="Error message" name="ErrorMessage" style="color: rgb(255, 0, 38); align-self: center; visibility: hidden;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="m_errorMessage" data-source-type="PopupWindowController, Assembly-CSharp" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
