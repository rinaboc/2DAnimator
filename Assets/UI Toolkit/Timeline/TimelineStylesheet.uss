.top-section {
    height: 60%;
    min-height: 65px;
    flex-direction: row;
}

.top-section-right {
    align-self: flex-end;
    height: 100%;
    width: 80%;
}

.top-section-left {
    width: 20%;
    align-items: center;
    justify-content: flex-end;
}

.header {
    flex-direction: row;
    align-items: stretch;
    color: rgb(169, 169, 168);
    height: 100%;
    padding-right: 10px;
}

.slider-container {
    background-color: rgb(51, 51, 51);
    height: 60%;
    border-bottom-width: 1px;
    border-left-color: rgb(22, 22, 22);
    border-right-color: rgb(22, 22, 22);
    border-top-color: rgb(22, 22, 22);
    border-bottom-color: rgb(22, 22, 22);
}

.slider-handle {
    height: 100%;
    background-color: rgb(169, 169, 168);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.slider-inputfield {
    width: 50px;
    color: rgb(34, 34, 34);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.slider-inputfield > #unity-text-input {
    background-color: rgb(169, 169, 168);
    -unity-text-align: upper-center;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
}

.close-timeline {
    height: 40px;
    width: 100%;
}

.open-timeline {
    height: 49%;
    width: 100%;
}

.keyframe-container {
    min-height: 200px;
}

.delete-keyframe-button {
    background-color: rgb(140, 140, 140);
    color: rgb(43, 43, 43);
    margin-top: 5px;
    margin-bottom: 5px;
}

.header > .unity-label {
    flex-grow: 1;
}

.rotate {
    rotate: 180deg;
}

.play-button {
    width: 42px;
    height: 42px;
    background-image: resource('UI/play');
    background-color: rgb(140, 140, 140);
    background-size: 60% 60%;
    -unity-background-image-tint-color: rgb(43, 43, 43);
}
